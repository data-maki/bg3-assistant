# Dev key for the local backend. Releases ship the key inside the app bundle
# instead: set RELEASE_OPENROUTER_API_KEY when running mac/scripts/build-app.sh
# and it is written to Resources/backend/.env. Users never see or enter a key;
# the app gates AI features on /health's ai_available flag.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
EXA_API_KEY=
