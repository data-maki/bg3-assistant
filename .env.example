# Non-secret app build setting. Only this URL is copied into the app plist.
# Use localhost for development or the deployed HTTPS origin for a release.
BG3_BACKEND_URL=http://127.0.0.1:8787

# Backend-server settings. Provider keys are read only by the backend and are
# never copied into the macOS app or its TestFlight package.
BG3_BACKEND_MODE=local
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
EXA_API_KEY=

# Hosted TestFlight backend settings. Change BG3_BACKEND_MODE to hosted and
# provide these values only on the server. Sandbox is required for TestFlight.
BG3_APPSTORE_BUNDLE_ID=com.datamaki.BG3HonorAssistant
BG3_APPSTORE_ENVIRONMENT=Sandbox
BG3_APPLE_ROOT_CA_DIR=certs
BG3_APPLE_ONLINE_CHECKS=true
BG3_AUTH_TOKEN_SECRET=
BG3_SUBJECT_HMAC_SECRET=
BG3_AUTH_TOKEN_TTL_SECONDS=3600
BG3_USAGE_DB_PATH=runs/usage.sqlite3
BG3_BUILD_IMPORT_LIFETIME_LIMIT=30
BG3_IMPORT_PROCESSING_LEASE_SECONDS=600
