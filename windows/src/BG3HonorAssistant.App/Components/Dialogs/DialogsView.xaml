<UserControl x:Class="BG3HonorAssistant.App.Components.Dialogs.DialogsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core">
    <Grid>
<Grid x:Name="ResetCharacterConfirmationOverlay"
              Grid.RowSpan="4"
              Panel.ZIndex="20"
              Background="#66000000"
              Visibility="Collapsed">
            <Border Width="321"
                    Height="204"
                    Padding="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BG3PanelBrush}"
                    BorderBrush="{StaticResource BG3BronzeBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ResetCharacterConfirmationTitleText"
                               Style="{StaticResource BG3PageTitle}"
                               Text="Reset this character plan?" />
                    <TextBlock Grid.Row="1"
                               Margin="0,10,0,0"
                               Style="{StaticResource BG3Caption}"
                               Text="This is a planner reset, not a Withers respec. It removes the assigned build, recorded ability sources, and equipped-item confirmations."
                               TextWrapping="Wrap" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BG3ActionButton}"
                                BorderBrush="{StaticResource BG3DangerBrush}"
                                Click="OnConfirmResetCharacterClick"
                                Content="Reset build, stats, and equipment" />
                        <Button Grid.Column="2"
                                Style="{StaticResource BG3ActionButton}"
                                Click="OnCancelResetCharacterClick"
                                Content="Cancel" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

<Grid x:Name="ActionConfirmationOverlay"
              Grid.RowSpan="4"
              Panel.ZIndex="21"
              Background="#66000000"
              Visibility="Collapsed">
            <Border Width="321"
                    MinHeight="204"
                    Padding="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BG3PanelBrush}"
                    BorderBrush="{StaticResource BG3BronzeBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ActionConfirmationTitleText"
                               Style="{StaticResource BG3PageTitle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ActionConfirmationBodyText"
                               Grid.Row="1"
                               Margin="0,10,0,12"
                               Style="{StaticResource BG3Caption}"
                               TextWrapping="Wrap" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ActionConfirmationConfirmButton"
                                Style="{StaticResource BG3ActionButton}"
                                BorderBrush="{StaticResource BG3DangerBrush}"
                                Click="OnConfirmActionClick" />
                        <Button Grid.Column="2"
                                Style="{StaticResource BG3ActionButton}"
                                Click="OnCancelActionClick"
                                Content="Cancel" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

<Grid x:Name="NewRunConfirmationOverlay"
              Grid.RowSpan="4"
              Panel.ZIndex="22"
              Background="#88000000"
              Visibility="Collapsed">
            <Border Width="260"
                    Height="286"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BG3PanelBrush}"
                    BorderBrush="{StaticResource BG3BronzeBrush}"
                    BorderThickness="1.2"
                    CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="NewRunConfirmationTitleText"
                               Style="{StaticResource BG3RowTitle}"
                               Text="Create a new run? Honor Run stays saved and can be resumed anytime."
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1"
                               Margin="0,12,0,8"
                               Style="{StaticResource BG3Body}"
                               FontSize="11"
                               Text="Both options reset levels, route progress, story outcomes, equipment, and act state. Presets keep the current roster and valid build selections."
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2">
                        <Button Style="{StaticResource BG3ProminentActionButton}"
                                Click="OnCreateRunWithPresetClick"
                                Content="Use Current Characters &amp; Builds" />
                        <Button Margin="0,6,0,0"
                                Style="{StaticResource BG3ActionButton}"
                                Click="OnCreateDefaultRunClick"
                                Content="Start With Default Party" />
                        <Button Margin="0,6,0,0"
                                Style="{StaticResource BG3ActionButton}"
                                Click="OnCancelNewRunClick"
                                Content="Cancel" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
