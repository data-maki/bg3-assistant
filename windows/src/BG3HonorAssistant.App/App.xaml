<Application x:Class="BG3HonorAssistant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#11131A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1B1E28" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#242836" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D5A64C" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F0E8" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#BBB5AA" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E17070" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#4A4F60" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </Application.Resources>
</Application>
