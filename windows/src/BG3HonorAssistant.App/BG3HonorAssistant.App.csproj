<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>BG3HonorAssistant</AssemblyName>
    <RootNamespace>BG3HonorAssistant.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BG3HonorAssistant.Core\BG3HonorAssistant.Core.csproj" />
    <ProjectReference Include="..\BG3HonorAssistant.Infrastructure\BG3HonorAssistant.Infrastructure.csproj" />
    <ProjectReference Include="..\BG3HonorAssistant.Windows\BG3HonorAssistant.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\Resources\Data\guide-bundle.json"
             Link="Resources\Data\guide-bundle.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\Resources\CompanionPortraits\**\*"
             Link="Resources\CompanionPortraits\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\Resources\ItemIcons\**\*"
             Link="Resources\ItemIcons\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\Resources\BuildOptionIcons\**\*"
             Link="Resources\BuildOptionIcons\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\Resources\twilight-cleric.webp"
             Link="Resources\twilight-cleric.webp"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\Resources\THIRD_PARTY_NOTICES.md"
             Link="Resources\THIRD_PARTY_NOTICES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
