<Window x:Class="BG3HonorAssistant.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BG3 Honor Assistant overlay"
        Width="437"
        Height="165"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        SourceInitialized="OnSourceInitialized"
        Deactivated="OnDeactivated">
    <Grid Cursor="SizeAll"
          MouseLeftButtonDown="OnDragMouseLeftButtonDown">
        <Grid x:Name="MinimalPanel"
              Margin="8"
              MouseEnter="OnPetMouseEnter"
              MouseLeave="OnPetMouseLeave"
              MouseMove="OnPetMouseMove">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <Image x:Name="PetImage"
                   Grid.Column="0"
                   Width="70"
                   Height="82"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Stretch="Uniform"
                   AutomationProperties.Name="Twilight Cleric companion"
                   AutomationProperties.HelpText="Hover to wake the companion">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="7"
                                      Direction="270"
                                      ShadowDepth="3"
                                      Opacity="0.5"
                                      Color="Black" />
                </Image.Effect>
            </Image>
            <TextBlock x:Name="PetFallbackText"
                       Grid.Column="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource BG3SerifFont}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource BG3GoldBrush}"
                       Text="H" />
            <Button Grid.Column="2"
                    Width="34"
                    Height="36"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource BG3ProminentActionButton}"
                    AutomationProperties.Name="Show current goal"
                    Click="OnShowGoalClick">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="10"
                           Foreground="{StaticResource BG3ParchmentBrush}"
                           Text="&#xE76C;" />
            </Button>
        </Grid>

        <Grid x:Name="FocusPanel"
              Margin="8">
            <Grid.ContextMenu>
                <ContextMenu AutomationProperties.Name="Overlay actions">
                    <MenuItem Header="Open chat"
                              Click="OnOpenChatClick" />
                    <MenuItem Header="Snooze warnings 10 minutes"
                              Click="OnSnoozeClick" />
                    <MenuItem Header="Mute checkpoint"
                              Click="OnMuteClick" />
                    <MenuItem Header="Pin or unpin fight"
                              Click="OnPinClick" />
                    <Separator />
                    <MenuItem Header="Overlay density">
                        <MenuItem Header="Minimal"
                                  Click="OnMinimalDensityClick" />
                        <MenuItem Header="Focus"
                                  Click="OnFocusDensityClick" />
                        <MenuItem Header="Reference"
                                  Click="OnReferenceDensityClick" />
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>

            <Border Background="{StaticResource BG3PanelBrush}"
                    BorderBrush="{StaticResource BG3BronzeBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14">
                <Grid>
                    <Border Margin="3"
                            BorderBrush="#57C7A15E"
                            BorderThickness="0.65"
                            CornerRadius="11" />
                    <Grid Margin="9">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="TopRow" Height="86" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="38" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Ellipse Fill="#C20E0C09"
                                         Stroke="{StaticResource BG3BronzeBrush}"
                                         StrokeThickness="2" />
                                <Ellipse Margin="3"
                                         Stroke="#7AC7A15E"
                                         StrokeThickness="0.7" />
                                <Image x:Name="FocusPetImage"
                                       Width="74"
                                       Height="74"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       IsHitTestVisible="False"
                                       AutomationProperties.Name="Twilight Cleric assistant" />
                            </Grid>

                            <Grid Grid.Column="2"
                                  Margin="0,1,4,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="LevelText"
                                               DockPanel.Dock="Right"
                                               Margin="6,0,0,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource BG3Overline}"
                                               Foreground="{StaticResource BG3CautionBrush}" />
                                    <TextBlock x:Name="TaskOverlineText"
                                               Style="{StaticResource BG3Overline}"
                                               Text="CURRENT TASK · ACT 1" />
                                </DockPanel>
                                <TextBlock x:Name="GoalText"
                                           Grid.Row="1"
                                           Margin="0,2,0,0"
                                           FontFamily="{StaticResource BG3SerifFont}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BG3ParchmentBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="34" />
                                <TextBlock x:Name="AvoidText"
                                           Grid.Row="2"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="31" />
                            </Grid>

                            <Button Grid.Column="3"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource BG3ProminentActionButton}"
                                    AutomationProperties.Name="Collapse to companion"
                                    Click="OnCollapseClick">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{StaticResource BG3ParchmentBrush}"
                                           Text="&#xE76B;" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Padding="2,2"
                                    Style="{StaticResource BG3ActionButton}"
                                    AutomationProperties.Name="Open route"
                                    Click="OnOpenRouteClick">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Text="&#xE707;" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource BG3Overline}"
                                               Foreground="{StaticResource BG3ParchmentBrush}"
                                               Text="Route" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Padding="2,2"
                                    Style="{StaticResource BG3ActionButton}"
                                    AutomationProperties.Name="Ask typed chat"
                                    Click="OnOpenChatClick">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Text="&#xE8BD;" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource BG3Overline}"
                                               Foreground="{StaticResource BG3ParchmentBrush}"
                                               Text="Ask" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4"
                                    Padding="2,2"
                                    Style="{StaticResource BG3SuccessActionButton}"
                                    AutomationProperties.Name="Mark current task complete"
                                    Click="OnTaskDoneClick">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Text="&#xE73E;" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource BG3Overline}"
                                               Foreground="{StaticResource BG3ParchmentBrush}"
                                               Text="Task done" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
