<Window x:Class="BG3HonorAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BG3 Honor Assistant"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="24,18"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="#353A49"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Text="BG3 Honor Assistant" />
                    <TextBlock x:Name="HeaderStatusText"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               AutomationProperties.AutomationId="HeaderStatusText"
                               Text="Loading the local guide…" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <ComboBox x:Name="RunPicker"
                              Width="190"
                              Margin="0,0,10,0"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="Current run"
                              SelectionChanged="OnRunSelectionChanged" />
                    <TextBox x:Name="RunNameTextBox"
                             Width="150"
                             Margin="0,0,8,0"
                             AutomationProperties.Name="Run name" />
                    <Button AutomationProperties.Name="Rename current run"
                            Click="OnRenameRunClick"
                            Content="Rename" />
                    <Button AutomationProperties.Name="Create a new run"
                            Click="OnNewRunClick"
                            Content="New run" />
                    <Button AutomationProperties.Name="Launch Baldur's Gate 3 through Steam"
                            Click="OnLaunchGameClick"
                            Content="Launch BG3" />
                    <Button AutomationProperties.Name="Show overlay preview"
                            Click="OnShowOverlayClick"
                            Content="Show overlay" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="PlannerTabs"
                    Grid.Row="1"
                    Margin="20"
                    AutomationProperties.Name="Assistant sections">
            <TabItem Header="Now">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Text="CURRENT GOAL"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="GoalTitleText"
                                   Margin="0,6,0,0"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="GoalMetaText"
                                   Margin="0,5,0,20"
                                   FontSize="15"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Border Padding="18"
                                Background="{DynamicResource PanelBrush}"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="GoalAvoidText"
                                           FontSize="16"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ReadinessText"
                                           Margin="0,14,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,18,0,0">
                            <Button AutomationProperties.Name="Mark current activity complete"
                                    Click="OnCompleteCurrentClick"
                                    Content="Done" />
                            <Button AutomationProperties.Name="Skip current activity"
                                    Click="OnSkipCurrentClick"
                                    Content="Skip" />
                            <Button AutomationProperties.Name="Revisit current activity"
                                    Click="OnRevisitCurrentClick"
                                    Content="Revisit" />
                            <Button AutomationProperties.Name="Follow recommended route"
                                    Click="OnFollowRouteClick"
                                    Content="Follow recommendation" />
                            <Button x:Name="MuteButton"
                                    AutomationProperties.Name="Mute warnings for current checkpoint"
                                    Click="OnMuteClick"
                                    Content="Mute warnings" />
                            <Button x:Name="ClearTargetButton"
                                    AutomationProperties.Name="Clear current equipment target"
                                    Click="OnClearTargetClick"
                                    Content="Clear gear target"
                                    Visibility="Collapsed" />
                            <Button x:Name="PinFightButton"
                                    AutomationProperties.Name="Pin current fight"
                                    Click="OnPinFightClick"
                                    Content="Pin fight" />
                            <Button AutomationProperties.Name="Snooze warnings for ten minutes"
                                    Click="OnSnoozeClick"
                                    Content="Snooze 10 min" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Route">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="12"
                                Margin="0,0,0,10"
                                Background="{DynamicResource PanelBrush}"
                                CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="ROUTE"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock x:Name="RouteProgressText"
                                               DockPanel.Dock="Right"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </DockPanel>
                                <ProgressBar x:Name="RouteProgressBar"
                                             Height="7"
                                             Margin="0,7,0,7"
                                             Minimum="0"
                                             Maximum="1"
                                             AutomationProperties.Name="Route progress" />
                                <TextBlock x:Name="RouteGateText"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteSpoilerText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap" />
                                <ComboBox x:Name="RouteFilterPicker"
                                          Margin="0,9,0,0"
                                          AutomationProperties.Name="Route contents filter"
                                          SelectionChanged="OnRouteFilterChanged" />
                                <Expander x:Name="RouteDeadlinesExpander"
                                          Margin="0,8,0,0"
                                          Header="Deadlines and lockouts">
                                    <ListBox x:Name="RouteDeadlineList"
                                             Margin="0,5,0,0"
                                             AutomationProperties.Name="Route deadlines">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Text="{Binding Deadline}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{DynamicResource DangerBrush}"
                                                               Text="{Binding Consequence}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="RouteList"
                                 Grid.Row="1"
                                 AutomationProperties.Name="Route and equipment steps"
                                 SelectionChanged="OnRouteSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding Label}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="{Binding Meta}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{Binding Status}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <ScrollViewer Grid.Column="1"
                                  Margin="20,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="RouteStepPanel">
                                <TextBlock x:Name="RouteStepTitleText"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepMetaText"
                                           Margin="0,5,0,14"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="RouteStepSummaryText"
                                           FontSize="15"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepAvoidText"
                                           Margin="0,14,0,0"
                                           Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepWhyText"
                                           Margin="0,14,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepRewardsText"
                                           Margin="0,14,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepPrerequisitesText"
                                           Margin="0,10,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepCompletionText"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepOutcomeText"
                                           Margin="0,10,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap" />
                                <GroupBox x:Name="RouteDecisionGroup"
                                          Margin="0,14,0,0"
                                          Padding="10"
                                          Header="Reviewed choice">
                                    <StackPanel>
                                        <TextBlock x:Name="RouteDecisionText"
                                                   TextWrapping="Wrap" />
                                        <ComboBox x:Name="RouteOutcomePicker"
                                                  Margin="0,8,0,0"
                                                  DisplayMemberPath="Label"
                                                  AutomationProperties.Name="Route outcome" />
                                        <Button Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Click="OnRecordOutcomeClick"
                                                Content="Record selected outcome" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox x:Name="RouteIncidentGroup"
                                          Margin="0,14,0,0"
                                          Padding="10"
                                          Header="If the plan breaks">
                                    <TextBlock x:Name="RouteIncidentText"
                                               TextWrapping="Wrap" />
                                </GroupBox>
                                <GroupBox x:Name="RouteRiskGroup"
                                          Margin="0,14,0,0"
                                          Padding="10"
                                          Header="Risk and reward">
                                    <TextBlock x:Name="RouteRiskText"
                                               TextWrapping="Wrap" />
                                </GroupBox>
                                <WrapPanel Margin="0,20,0,0">
                                    <Button Click="OnFocusSelectedStepClick"
                                            Content="Focus this step" />
                                    <Button Click="OnCompleteSelectedStepClick"
                                            Content="Mark done" />
                                    <Button Click="OnSkipSelectedStepClick"
                                            Content="Skip" />
                                    <Button Click="OnRevisitSelectedStepClick"
                                            Content="Revisit" />
                                    <Button x:Name="RouteSourceButton"
                                            Click="OnOpenRouteSourceClick"
                                            Content="Open reviewed source" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel x:Name="RouteGearPanel"
                                        Visibility="Collapsed">
                                <TextBlock Text="ROUTE PICKUP"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="RouteGearTitleText"
                                           Margin="0,5,0,0"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteGearMetaText"
                                           Margin="0,5,0,14"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteGearEffectText"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteGearAcquisitionText"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteGearWhyText"
                                           Margin="0,12,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteGearRequirementText"
                                           Margin="0,12,0,0"
                                           Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,18,0,0">
                                    <Button Click="OnTrackRouteGearClick"
                                            Content="Track this item now" />
                                    <Button Click="OnMarkRouteGearObtainedClick"
                                            Content="Mark obtained" />
                                    <Button Click="OnOpenRouteGearLinkClick"
                                            Content="Open item source" />
                                </WrapPanel>
                            </StackPanel>
                            <Expander Margin="0,20,0,0"
                                      Header="Done, skipped, and caught-up steps">
                                <ListBox x:Name="ArchivedRouteList"
                                         Margin="0,8,0,0"
                                         AutomationProperties.Name="Archived route steps"
                                         SelectionChanged="OnArchivedRouteSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Label}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding Meta}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Party">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Roster and active party"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <DataGrid x:Name="PartyGrid"
                              Grid.Row="1"
                              Margin="0,14,0,14"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              AutomationProperties.Name="Party roster">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Header="Name" Binding="{Binding Name}" />
                            <DataGridTextColumn Width="*" Header="Level" Binding="{Binding Level}" />
                            <DataGridTextColumn Width="2*" Header="Class" Binding="{Binding ClassName}" />
                            <DataGridTextColumn Width="2*" Header="Status" Binding="{Binding RosterStatus}" />
                            <DataGridTextColumn Width="2*" Header="Build" Binding="{Binding BuildId}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2">
                        <Button Click="OnLevelDownClick" Content="Level −" />
                        <Button Click="OnLevelUpClick" Content="Level +" />
                        <Button Click="OnSendToCampClick" Content="Send to camp" />
                        <Button Click="OnMakeActiveClick" Content="Make active" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Loadout">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="BuildList"
                             DisplayMemberPath="Name"
                             AutomationProperties.Name="Reviewed builds"
                             SelectionChanged="OnBuildSelectionChanged" />
                    <ScrollViewer Grid.Column="1"
                                  Margin="20,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="BuildTitleText"
                                       FontSize="25"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="BuildRoleText"
                                       Margin="0,5,0,12"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock x:Name="BuildPatternText"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,18,0,5"
                                       FontWeight="SemiBold"
                                       Text="Assign to active character" />
                            <ComboBox x:Name="BuildMemberPicker"
                                      Width="260"
                                      HorizontalAlignment="Left"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.Name="Build character" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Click="OnAssignBuildClick"
                                        Content="Assign selected build" />
                                <Button Click="OnClearBuildClick"
                                        Content="Clear character build" />
                            </WrapPanel>
                            <TextBlock Margin="0,18,0,8"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Planned equipment" />
                            <ListBox x:Name="BuildGearList"
                                     DisplayMemberPath="Item"
                                     AutomationProperties.Name="Build equipment" />
                             <Button Margin="0,10,0,0"
                                     HorizontalAlignment="Left"
                                     Click="OnTrackGearClick"
                                     Content="Track selected item now" />
                            <GroupBox Margin="0,22,0,0"
                                      Padding="14"
                                      Header="Import a public build">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="Imports accept public HTTPS:443 HTML, text, or PDF up to 5 MB. OpenRouter extracts a draft; imported choices are always marked for in-game verification."
                                               TextWrapping="Wrap" />
                                    <TextBox x:Name="BuildImportUrlTextBox"
                                             Margin="0,10,0,0"
                                             AutomationProperties.Name="Public build URL"
                                             AutomationProperties.HelpText="HTTPS URL on port 443"
                                             TextWrapping="NoWrap" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="ImportBuildButton"
                                                Click="OnImportBuildClick"
                                                Content="Import with OpenRouter" />
                                        <Button Click="OnDeleteImportedBuildClick"
                                                Content="Remove selected import" />
                                    </WrapPanel>
                                    <TextBlock x:Name="BuildImportStatusText"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="A saved OpenRouter key is required. Source text and model prompts are not retained."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Act">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock x:Name="ActTitleText"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ActAvailabilityText"
                                   Margin="0,8,0,18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ActCountsText"
                                   FontSize="15" />
                        <TextBlock x:Name="ActGateText"
                                   Margin="0,15,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,20,0,8"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Equipment review" />
                        <ListBox x:Name="ActGearList"
                                 Height="180"
                                 DisplayMemberPath="Item"
                                 AutomationProperties.Name="Current act equipment review" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Click="OnActGearObtainedClick"
                                    Content="Mark obtained" />
                            <Button Click="OnActGearMissedClick"
                                    Content="Mark missed" />
                            <Button x:Name="AdvanceActButton"
                                    Click="OnAdvanceActClick"
                                    Content="Advance to next act" />
                            <Button Click="OnOpenActMapClick"
                                    Content="Open act map" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Chat">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ChatAvailabilityText"
                               Text="Typed OpenRouter chat is session-only; messages are never saved."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <WrapPanel Grid.Row="1"
                               Margin="0,10,0,8">
                        <TextBlock Margin="0,5,8,0"
                                   FontWeight="SemiBold"
                                   Text="Scope" />
                        <ComboBox x:Name="ChatScopePicker"
                                  Width="145"
                                  AutomationProperties.Name="Chat guide scope" />
                        <Button Margin="12,0,0,0"
                                Click="OnQuickChatClick"
                                Content="What's next?"
                                Tag="What's next?" />
                        <Button Click="OnQuickChatClick"
                                Content="How do I not die?"
                                Tag="How do I not die here?" />
                        <Button Click="OnQuickChatClick"
                                Content="Is my party ready?"
                                Tag="Is my party ready?" />
                        <Button Click="OnClearChatClick"
                                Content="Clear chat" />
                    </WrapPanel>
                    <RichTextBox x:Name="ChatHistoryBox"
                                 Grid.Row="2"
                                 MinHeight="180"
                                 IsDocumentEnabled="True"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Session chat history" />
                    <TextBlock x:Name="ChatStatusText"
                               Grid.Row="3"
                               Margin="0,8,0,8"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Ready for a typed question."
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4"
                               Margin="0,0,0,7"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Ctrl+Enter sends. Answers use only the selected bundled-guide context."
                               TextWrapping="Wrap" />
                    <DockPanel Grid.Row="5">
                        <TextBox x:Name="ChatDraftTextBox"
                                 MinHeight="72"
                                 AcceptsReturn="True"
                                 KeyDown="OnChatDraftKeyDown"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="Chat message" />
                        <Button x:Name="SendChatButton"
                                Margin="10,0,0,0"
                                VerticalAlignment="Bottom"
                                Click="OnSendChatClick"
                                Content="Send" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <GroupBox Padding="16" Header="Overlay">
                            <StackPanel>
                                <CheckBox x:Name="ShowOverlayCheckBox"
                                          Content="Show automatically while a supported BG3 window is present"
                                          Click="OnOverlayPreferenceChanged" />
                                <TextBlock Margin="0,12,0,5"
                                           Text="Collapsed overlay density" />
                                <ComboBox x:Name="OverlayDensityPicker"
                                          Width="220"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="OnOverlayPreferenceChanged" />
                                <CheckBox x:Name="ReducedMotionCheckBox"
                                          Margin="0,12,0,0"
                                          Content="Reduce nonessential motion"
                                          Click="OnOverlayPreferenceChanged" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Padding="16" Header="Start at login">
                            <StackPanel>
                                <TextBlock x:Name="StartupStatusText"
                                           AutomationProperties.AutomationId="StartupStatusText"
                                           TextWrapping="Wrap"
                                           Text="Checking startup state…" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="EnableStartupButton"
                                            AutomationProperties.Name="Enable start at login"
                                            Click="OnEnableStartupClick"
                                            Content="Enable" />
                                    <Button x:Name="DisableStartupButton"
                                            AutomationProperties.Name="Disable start at login"
                                            Click="OnDisableStartupClick"
                                            Content="Disable" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Padding="16" Header="OpenRouter">
                            <StackPanel>
                                <TextBlock Text="Optional typed chat and public build import use your own OpenRouter account."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Pinned release model: google/gemini-3.6-flash"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="OpenRouterKeyStatusText"
                                           Margin="0,10,0,4"
                                           AutomationProperties.AutomationId="OpenRouterKeyStatusText"
                                           Text="Checking Windows Credential Manager…"
                                           TextWrapping="Wrap" />
                                <PasswordBox x:Name="OpenRouterKeyPasswordBox"
                                             Width="440"
                                             HorizontalAlignment="Left"
                                             AutomationProperties.Name="OpenRouter API key"
                                             AutomationProperties.HelpText="Stored only in Windows Credential Manager" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Click="OnSaveOpenRouterKeyClick"
                                            Content="Save or replace key" />
                                    <Button x:Name="TestOpenRouterButton"
                                            Click="OnTestOpenRouterClick"
                                            Content="Test connection" />
                                    <Button Click="OnRemoveOpenRouterKeyClick"
                                            Content="Remove key" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Padding="16" Header="Package and storage">
                            <StackPanel>
                                <TextBlock x:Name="PackageStatusText"
                                           AutomationProperties.AutomationId="PackageStatusText"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="StoragePathText"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="Diagnostics" />
                        <TextBlock x:Name="DiagnosticsText"
                                   Margin="0,14,0,0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Padding="16,8"
                Background="{DynamicResource PanelBrush}">
            <TextBlock x:Name="FooterStatusText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Local guide ready." />
        </Border>

        <Border x:Name="OnboardingPanel"
                Grid.RowSpan="3"
                Margin="70"
                Padding="30"
                Background="{DynamicResource PanelRaisedBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="SETUP"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="OnboardingTitleText"
                               Margin="0,8,0,0"
                               FontSize="30"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Margin="0,24,0,24">
                    <TextBlock x:Name="OnboardingBodyText"
                               FontSize="16"
                               TextWrapping="Wrap" />
                    <ComboBox x:Name="OnboardingChoicePicker"
                              Width="360"
                              Margin="0,20,0,0"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="Setup choice" />
                </StackPanel>
                <DockPanel Grid.Row="2">
                    <Button x:Name="OnboardingBackButton"
                            DockPanel.Dock="Left"
                            Click="OnOnboardingBackClick"
                            Content="Back" />
                    <Button x:Name="OnboardingNextButton"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Click="OnOnboardingNextClick"
                            Content="Continue" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
