<Window x:Class="BG3HonorAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core"
        xmlns:now="clr-namespace:BG3HonorAssistant.App.Screens.Now"
        xmlns:route="clr-namespace:BG3HonorAssistant.App.Screens.Route"
        xmlns:party="clr-namespace:BG3HonorAssistant.App.Screens.Party"
        xmlns:loadout="clr-namespace:BG3HonorAssistant.App.Screens.Loadout"
        xmlns:act="clr-namespace:BG3HonorAssistant.App.Screens.Act"
        xmlns:chat="clr-namespace:BG3HonorAssistant.App.Screens.Chat"
        xmlns:settings="clr-namespace:BG3HonorAssistant.App.Screens.Settings"
        xmlns:dialogs="clr-namespace:BG3HonorAssistant.App.Components.Dialogs"
        xmlns:onboarding="clr-namespace:BG3HonorAssistant.App.Components.Onboarding"
        Title="BG3 Honor Assistant"
        Width="420"
        Height="410"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="49" />
            <RowDefinition Height="31" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="4"
                Background="{StaticResource BG3PanelBrush}"
                BorderBrush="{StaticResource BG3BronzeBrush}"
                BorderThickness="1.5"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  Direction="270"
                                  ShadowDepth="8"
                                  Opacity="0.46"
                                  Color="Black" />
            </Border.Effect>
        </Border>
        <Border Grid.RowSpan="4"
                Margin="3"
                BorderBrush="#57C7A15E"
                BorderThickness="0.65"
                CornerRadius="13"
                IsHitTestVisible="False" />

        <Grid Grid.Row="0"
              Margin="10,5,10,1"
              MouseLeftButtonDown="OnPlannerDragMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <Image x:Name="HeaderPetImage"
                   Grid.Column="0"
                   Width="42"
                   Height="42"
                   Stretch="Uniform"
                   IsHitTestVisible="False"
                   AutomationProperties.Name="Twilight Cleric assistant" />
            <TextBlock x:Name="HeaderStatusText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource BG3SerifFont}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{StaticResource BG3ParchmentBrush}"
                       Text="Now"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="3"
                    Style="{StaticResource BG3IconButton}"
                    AutomationProperties.Name="Open current act map"
                    Click="OnOpenActMapClick">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Text="&#xE707;" />
            </Button>
            <Button Grid.Column="5"
                    Style="{StaticResource BG3IconButton}"
                    AutomationProperties.Name="Open typed chat"
                    Click="OnPlannerTabClick"
                    Tag="5">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Text="&#xE8BD;" />
            </Button>
            <Button Grid.Column="7"
                    Style="{StaticResource BG3IconButton}"
                    AutomationProperties.Name="Open settings"
                    Click="OnPlannerTabClick"
                    Tag="6">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Text="&#xE713;" />
            </Button>
            <Button Grid.Column="9"
                    Style="{StaticResource BG3IconButton}"
                    AutomationProperties.Name="Collapse to companion"
                    Click="OnCollapsePlannerClick">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Text="&#xE70D;" />
            </Button>

        </Grid>

        <Border Grid.Row="1"
                Margin="10,0,10,3"
                Padding="3"
                Background="#850E0C09"
                BorderBrush="#858C5224"
                BorderThickness="0.7"
                CornerRadius="14">
            <UniformGrid Columns="5">
                <Button x:Name="NowTabButton"
                        Style="{StaticResource BG3PlannerTabButton}"
                        Click="OnPlannerTabClick"
                        Content="NOW"
                        Tag="0" />
                <Button x:Name="RouteTabButton"
                        Style="{StaticResource BG3PlannerTabButton}"
                        Click="OnPlannerTabClick"
                        Content="ROUTE"
                        Tag="1" />
                <Button x:Name="PartyTabButton"
                        Style="{StaticResource BG3PlannerTabButton}"
                        Click="OnPlannerTabClick"
                        Content="PARTY"
                        Tag="2" />
                <Button x:Name="LoadoutTabButton"
                        Style="{StaticResource BG3PlannerTabButton}"
                        Click="OnPlannerTabClick"
                        Content="LOADOUT"
                        Tag="3" />
                <Button x:Name="ActTabButton"
                        Style="{StaticResource BG3PlannerTabButton}"
                        Click="OnPlannerTabClick"
                        Content="ACT"
                        Tag="4" />
            </UniformGrid>
        </Border>

        <!-- Screen content is replaced tab by tab; the stock tab strip is hidden. -->
        <TabControl x:Name="PlannerTabs"
                    Grid.Row="2"
                    Margin="10,0,10,10"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="OnPlannerSelectionChanged"
                    AutomationProperties.Name="Assistant sections">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="Now">
                <now:NowView x:Name="NowScreen" />
            </TabItem>

            <TabItem Header="Route">
                <route:RouteView x:Name="RouteScreen" />
            </TabItem>

            <TabItem Header="Party">
                <party:PartyView x:Name="PartyScreen" />
            </TabItem>

            <TabItem Header="Loadout">
                <loadout:LoadoutView x:Name="LoadoutScreen" />
            </TabItem>

            <TabItem Header="Act">
                <act:ActView x:Name="ActScreen" />
            </TabItem>

            <TabItem Header="Chat">
                <chat:ChatView x:Name="ChatScreen" />
            </TabItem>

            <TabItem Header="Settings">
                <settings:SettingsView x:Name="SettingsScreen" />
            </TabItem>
        </TabControl>

        <dialogs:DialogsView x:Name="Dialogs" Grid.RowSpan="4" />
        <onboarding:OnboardingView x:Name="Onboarding" Grid.RowSpan="4" />
    </Grid>
</Window>
