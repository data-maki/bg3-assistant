<UserControl x:Class="BG3HonorAssistant.App.Screens.Settings.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core"
        Background="Transparent">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,28,10,10">
                        <TextBlock Margin="10,0,0,8"
                                   Style="{StaticResource BG3RowTitle}"
                                   Text="AI Provider" />
                        <Border Padding="10"
                                Background="#3E7D9194"
                                BorderBrush="#347D9194"
                                BorderThickness="0.5"
                                CornerRadius="9">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BG3Body}"
                                               Text="Provider" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource BG3Body}"
                                               Text="OpenRouter" />
                                </Grid>
                                <Border Margin="0,7" BorderBrush="#357D9194" BorderThickness="0,0,0,0.7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BG3Body}"
                                               Text="Model" />
                                    <TextBlock x:Name="OpenRouterModelText"
                                               Grid.Column="1"
                                               Style="{StaticResource BG3Caption}"
                                               Foreground="{StaticResource BG3ParchmentBrush}"
                                               Text="Pinned OpenRouter model" />
                                </Grid>
                                <Border Margin="0,7" BorderBrush="#357D9194" BorderThickness="0,0,0,0.7" />
                                <TextBlock x:Name="OpenRouterKeyStatusText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BG3Caption}"
                                           Foreground="{StaticResource BG3ParchmentBrush}"
                                           Text="⌘  API key saved in Credential Manager"
                                           TextWrapping="Wrap" />
                                <Grid x:Name="OpenRouterSavedPanel">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Right"
                                            Padding="8,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnShowOpenRouterEntryClick"
                                            Content="Replace" />
                                    <Button x:Name="TestOpenRouterButton"
                                            Grid.Column="2"
                                            Margin="0,6,0,0"
                                            Padding="8,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnTestOpenRouterClick"
                                            Content="Test" />
                                    <Button Grid.Column="4"
                                            Margin="0,6,0,0"
                                            Padding="8,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            BorderBrush="{StaticResource BG3DangerBrush}"
                                            Click="OnRemoveOpenRouterKeyClick"
                                            Content="Remove" />
                                </Grid>
                                <StackPanel x:Name="OpenRouterEntryPanel"
                                            Visibility="Collapsed">
                                    <PasswordBox x:Name="OpenRouterKeyPasswordBox"
                                                 AutomationProperties.Name="OpenRouter API key"
                                                 AutomationProperties.HelpText="Stored only in Windows Credential Manager" />
                                    <Button Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource BG3ProminentActionButton}"
                                            Click="OnSaveOpenRouterKeyClick"
                                            Content="Save API key" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           FontSize="9"
                                           Opacity="0.64"
                                           Text="Keys are stored only in Windows Credential Manager."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="10,26,0,8"
                                   Style="{StaticResource BG3RowTitle}"
                                   Text="General" />
                        <Border Padding="10"
                                Background="#3E7D9194"
                                BorderBrush="#347D9194"
                                BorderThickness="0.5"
                                CornerRadius="9">
                            <StackPanel>
                                <CheckBox x:Name="ShowOverlayCheckBox"
                                          HorizontalContentAlignment="Stretch"
                                          Content="Show overlay while BG3 is running"
                                          Click="OnOverlayPreferenceChanged" />
                                <Border Margin="0,7" BorderBrush="#357D9194" BorderThickness="0,0,0,0.7" />
                                <CheckBox x:Name="StartupToggle"
                                          Content="Launch at login"
                                          Click="OnStartupToggleClick" />
                                <TextBlock x:Name="StartupStatusText"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           FontSize="9"
                                           AutomationProperties.AutomationId="StartupStatusText"
                                           Text="Checking startup state…"
                                           TextWrapping="Wrap" />
                                <Border Margin="0,7" BorderBrush="#357D9194" BorderThickness="0,0,0,0.7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource BG3Body}"
                                               Text="Collapsed overlay" />
                                    <ComboBox x:Name="OverlayDensityPicker"
                                              Grid.Column="1"
                                              SelectionChanged="OnOverlayPreferenceChanged" />
                                </Grid>
                                <Border Margin="0,7" BorderBrush="#357D9194" BorderThickness="0,0,0,0.7" />
                                <Button HorizontalAlignment="Left"
                                        Style="{StaticResource BG3ActionButton}"
                                        Click="OnReplayTourClick"
                                        Content="✦  Replay Tour" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="10,26,0,8"
                                   Style="{StaticResource BG3RowTitle}"
                                   Text="Runs" />
                        <Border Padding="10"
                                Background="#3E7D9194"
                                BorderBrush="#347D9194"
                                BorderThickness="0.5"
                                CornerRadius="9">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource BG3Body}"
                                               Text="Active run" />
                                    <ComboBox x:Name="RunPicker"
                                              Grid.Column="1"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="OnRunSelectionChanged" />
                                </Grid>
                                <Border Margin="0,7" BorderBrush="#357D9194" BorderThickness="0,0,0,0.7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource BG3Body}"
                                               Text="Current run name" />
                                    <TextBox x:Name="RunNameTextBox"
                                             Grid.Column="1" />
                                    <Button Grid.Column="3"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnRenameRunClick"
                                            Content="Rename" />
                                </Grid>
                                <Border Margin="0,7" BorderBrush="#357D9194" BorderThickness="0,0,0,0.7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource BG3Body}"
                                               Text="Difficulty" />
                                    <ComboBox x:Name="RunDifficultyPicker"
                                              Grid.Column="1"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="OnRunSettingChanged" />
                                </Grid>
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           FontSize="9"
                                           Text="Explorer is intentionally checklist-free. Custom rule combinations are not offered because their encounter rules vary."
                                           TextWrapping="Wrap" />
                                <Border Margin="0,7" BorderBrush="#357D9194" BorderThickness="0,0,0,0.7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource BG3Body}"
                                               Text="Route spoilers" />
                                    <ComboBox x:Name="RunRevealPicker"
                                              Grid.Column="1"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="OnRunSettingChanged" />
                                </Grid>
                                <Border Margin="0,12,0,7" BorderBrush="#357D9194" BorderThickness="0,0,0,0.7" />
                                <TextBlock Style="{StaticResource BG3Body}"
                                           FontWeight="SemiBold"
                                           Text="New run name (optional)" />
                                <TextBox x:Name="NewRunNameTextBox"
                                         Margin="0,5,0,0" />
                                <Button Margin="0,7,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource BG3ActionButton}"
                                        Click="OnNewRunClick"
                                        Content="＋  New Run" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="10,26,0,8"
                                   Style="{StaticResource BG3RowTitle}"
                                   Text="Support" />
                        <Border Padding="10"
                                Background="#3E7D9194"
                                BorderBrush="#347D9194"
                                BorderThickness="0.5"
                                CornerRadius="9">
                            <StackPanel>
                                <Button HorizontalAlignment="Left"
                                        Style="{StaticResource BG3ActionButton}"
                                        Click="OnReportBugClick"
                                        Content="♙  Report a Bug" />
                                <Border Margin="0,8" BorderBrush="#357D9194" BorderThickness="0,0,0,0.7" />
                                <TextBlock Style="{StaticResource BG3Caption}"
                                           Text="Opens your email app with the developer address filled in." />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="10"
                                Background="#3E7D9194"
                                BorderBrush="#347D9194"
                                BorderThickness="0.5"
                                CornerRadius="9">
                            <Expander Header="Legal &amp; Credits">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource BG3Caption}"
                                               Text="BG3 Honor Assistant is unofficial fan content. It is not commissioned, sponsored, endorsed, or approved by Larian Studios or Wizards of the Coast."
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,7,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnOpenLegalLinkClick"
                                            Content="Baldur's Gate 3 Fan Content Terms"
                                            Tag="https://baldursgate3.game/bg3-fan-content-terms/" />
                                     <Button Margin="0,5,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnOpenLegalLinkClick"
                                             Content="Wizards Fan Content Policy"
                                             Tag="https://company.wizards.com/en/legal/fancontentpolicy" />
                                    <Button Margin="0,5,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnOpenLegalLinkClick"
                                            Content="Bg3.wiki Copyrights"
                                            Tag="https://bg3.wiki/wiki/bg3wiki:Copyrights" />
                                    <Button Margin="0,5,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnOpenThirdPartyNoticesClick"
                                            Content="Open Third-Party Notices" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Border Margin="0,10,0,12"
                                Padding="10"
                                Background="#3E7D9194"
                                BorderBrush="#347D9194"
                                BorderThickness="0.5"
                                CornerRadius="9">
                            <Expander Header="Diagnostics">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock x:Name="PackageStatusText"
                                               Style="{StaticResource BG3Caption}"
                                               AutomationProperties.AutomationId="PackageStatusText"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="StoragePathText"
                                               Margin="0,5,0,0"
                                               Style="{StaticResource BG3Caption}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DiagnosticsText"
                                               Margin="0,7,0,0"
                                               Style="{StaticResource BG3Caption}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="9"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
