<UserControl x:Class="BG3HonorAssistant.App.Screens.Loadout.LoadoutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core"
        Background="Transparent">

                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LoadoutMainColumn" Width="*" />
                        <ColumnDefinition x:Name="LoadoutDetailColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="LoadoutMainPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock x:Name="LoadoutConfirmedText"
                                       DockPanel.Dock="Right"
                                       Style="{StaticResource BG3Caption}"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="LoadoutActText"
                                       Style="{StaticResource BG3Overline}"
                                       Text="LOADOUT · ACT 1" />
                        </DockPanel>
                        <ItemsControl x:Name="LoadoutPartyStrip"
                                      Grid.Row="1"
                                      Margin="0,7,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="LoadoutMemberButton"
                                            Margin="2,0"
                                            Style="{StaticResource BG3PlannerTabButton}"
                                            Click="OnLoadoutMemberClick">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <TextBlock x:Name="NoBuildWarning"
                                                       Margin="0,0,4,0"
                                                       Foreground="{StaticResource BG3WarningBrush}"
                                                       Text="⚠"
                                                       Visibility="Collapsed" />
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding BuildId}" Value="{x:Null}">
                                            <Setter TargetName="NoBuildWarning" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="LoadoutMemberButton" Property="Background" Value="{StaticResource BG3ProminentActionBrush}" />
                                            <Setter TargetName="LoadoutMemberButton" Property="BorderBrush" Value="{StaticResource BG3ProminentActionBorderBrush}" />
                                            <Setter TargetName="LoadoutMemberButton" Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Grid.Row="2"
                                   Margin="0,6,0,7">
                            <Button DockPanel.Dock="Right"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource BG3GoldBrush}"
                                    Click="OnEditLoadoutMemberClick"
                                    Content="edit ›" />
                            <TextBlock x:Name="LoadoutMemberSummaryText"
                                       Style="{StaticResource BG3Caption}" />
                        </DockPanel>
                        <Grid Grid.Row="3">
                            <ItemsControl x:Name="LoadoutGearGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="3"
                                                Padding="7,5"
                                                Style="{StaticResource BG3ActionButton}"
                                                IsEnabled="{Binding HasItem}"
                                                Click="OnLoadoutGearClick">
                                            <Grid Height="32">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="15" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28"
                                                        Height="28"
                                                        Background="#990E0C09"
                                                        BorderBrush="#808C5224"
                                                        BorderThickness="0.7"
                                                        CornerRadius="5">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource BG3BronzeBrightBrush}"
                                                                   Text="{Binding SlotGlyph}" />
                                                        <Image Stretch="UniformToFill"
                                                               Source="{Binding Icon, Converter={StaticResource ItemIconConverter}}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="5,0,0,0">
                                                    <TextBlock Style="{StaticResource BG3Caption}"
                                                               FontWeight="Bold"
                                                               Text="{Binding ItemName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource BG3Caption}"
                                                               FontSize="9"
                                                               Text="{Binding Region}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource BG3GoldBrush}"
                                                           Text="{Binding StatusGlyph}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="LoadoutEmptyPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="26"
                                           Foreground="{StaticResource BG3MutedParchmentBrush}"
                                           Text="♙" />
                                <TextBlock x:Name="LoadoutEmptyText"
                                           Margin="0,7,0,7"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                                <Button Style="{StaticResource BG3ProminentActionButton}"
                                        Click="OnEditLoadoutMemberClick"
                                        Content="Choose a build in Party" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid x:Name="GearDetailPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button HorizontalAlignment="Left"
                                    Style="{StaticResource BG3ActionButton}"
                                    Click="OnLoadoutBackClick"
                                    Content="‹  Loadout" />
                            <ScrollViewer Grid.Row="1"
                                          Margin="0,8,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Padding="10"
                                            Background="{StaticResource BG3InsetBrush}"
                                            BorderBrush="#668C5224"
                                            BorderThickness="0.7"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42"
                                                        Height="42"
                                                        Background="#990E0C09"
                                                        BorderBrush="{StaticResource BG3GoldBrush}"
                                                        BorderThickness="0.8"
                                                        CornerRadius="7">
                                                    <Image x:Name="GearDetailIcon"
                                                           Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="GearDetailTitleText"
                                                               Style="{StaticResource BG3RowTitle}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock x:Name="GearDetailMetaText"
                                                               Margin="0,3,0,0"
                                                               Style="{StaticResource BG3Caption}" />
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Padding="7,2"
                                                        Background="#338C5224"
                                                        BorderBrush="#808C5224"
                                                        BorderThickness="0.7"
                                                        CornerRadius="8">
                                                    <TextBlock x:Name="GearDetailStatusText"
                                                               Style="{StaticResource BG3Caption}"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="GearDetailEffectText"
                                                       Margin="0,9,0,0"
                                                       Style="{StaticResource BG3Body}"
                                                       Foreground="{StaticResource BG3GoldBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="GearDetailAcquisitionText"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource BG3Body}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="GearDetailWhyText"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource BG3Caption}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="GearDetailRequirementText"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource BG3Caption}"
                                                       Foreground="{StaticResource BG3WarningBrush}"
                                                       TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button x:Name="GearTargetButton"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource BG3ProminentActionButton}"
                                                        Click="OnGearTargetClick" />
                                                <Button x:Name="GearEquippedButton"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource BG3ActionButton}"
                                                        Click="OnGearEquippedClick" />
                                                <Button Margin="0,0,5,5"
                                                        Style="{StaticResource BG3ActionButton}"
                                                        Click="OnGearMapClick"
                                                        Content="Map" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,8,0,0"
                                            Padding="10"
                                            Background="{StaticResource BG3InsetBrush}"
                                            BorderBrush="#668C5224"
                                            BorderThickness="0.7"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button x:Name="GearRevertPickButton"
                                                        DockPanel.Dock="Right"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource BG3WarningBrush}"
                                                        Click="OnRevertLoadoutPickClick"
                                                        Content="Revert to build pick" />
                                                <TextBlock Style="{StaticResource BG3Overline}"
                                                           Text="CHANGE PICK" />
                                            </DockPanel>
                                            <TextBlock Margin="0,5,0,7"
                                                       Style="{StaticResource BG3Caption}"
                                                       Text="Choose another reviewed item for this slot through the current act."
                                                       TextWrapping="Wrap" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Margin="6,0,0,0"
                                                        Style="{StaticResource BG3ProminentActionButton}"
                                                        Click="OnUseLoadoutPickClick"
                                                        Content="Use" />
                                                <ComboBox x:Name="GearChangePicker"
                                                          DisplayMemberPath="Name" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="GearConflictPanel"
                                            Margin="0,8,0,0"
                                            Padding="10"
                                            Background="{StaticResource BG3InsetBrush}"
                                            BorderBrush="{StaticResource BG3WarningBrush}"
                                            BorderThickness="0.7"
                                            CornerRadius="9"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BG3Overline}"
                                                       Foreground="{StaticResource BG3WarningBrush}"
                                                       Text="PARTY CONFLICT" />
                                            <TextBlock x:Name="GearConflictText"
                                                       Margin="0,5,0,7"
                                                       Style="{StaticResource BG3Caption}"
                                                       TextWrapping="Wrap" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Margin="6,0,0,0"
                                                        Style="{StaticResource BG3ActionButton}"
                                                        Click="OnGiveLoadoutGearClick"
                                                        Content="Assign" />
                                                <ComboBox x:Name="GearGiveToPicker"
                                                          DisplayMemberPath="Name" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </Grid>
</UserControl>
