<UserControl x:Class="BG3HonorAssistant.App.Screens.Now.NowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core"
        Background="Transparent">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="47" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,7,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Padding="7,2"
                                        Margin="0,0,5,0"
                                        Background="#217D9194"
                                        BorderBrush="#7A7D9194"
                                        BorderThickness="0.7"
                                        CornerRadius="8">
                                    <TextBlock x:Name="GoalContextChipText"
                                               Style="{StaticResource BG3Overline}"
                                               Foreground="{StaticResource BG3MutedParchmentBrush}"
                                               Text="EXPLORE" />
                                </Border>
                                <Border Padding="7,2"
                                        Margin="0,0,5,0"
                                        Background="#217D9194"
                                        BorderBrush="#7A7D9194"
                                        BorderThickness="0.7"
                                        CornerRadius="8">
                                    <TextBlock x:Name="GoalDangerChipText"
                                               Style="{StaticResource BG3Caption}"
                                               FontWeight="Bold"
                                               Text="low risk" />
                                </Border>
                                <Border Padding="7,2"
                                        Background="#217D9194"
                                        BorderBrush="#7A7D9194"
                                        BorderThickness="0.7"
                                        CornerRadius="8">
                                    <TextBlock x:Name="GoalLevelChipText"
                                               Style="{StaticResource BG3Caption}"
                                               FontWeight="Bold"
                                               Text="L2+" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="GoalTitleText"
                                       Margin="0,6,0,0"
                                       FontFamily="{StaticResource BG3SerifFont}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BG3ParchmentBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="GoalMetaText"
                                       Margin="0,4,0,7"
                                       Style="{StaticResource BG3Caption}" />
                            <Border Height="1"
                                    Margin="0,0,0,7"
                                    Background="#668C5224" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource BG3GoldBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Text="→" />
                                <TextBlock x:Name="GoalDoText"
                                           Grid.Column="1"
                                           Style="{StaticResource BG3Body}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource BG3DangerBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Text="×" />
                                <TextBlock x:Name="GoalAvoidText"
                                           Grid.Column="1"
                                           Style="{StaticResource BG3Body}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource BG3MutedParchmentBrush}"
                                           FontSize="11"
                                           Text="◆" />
                                <TextBlock x:Name="GoalWhyText"
                                           Grid.Column="1"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <Expander x:Name="NowMoreExpander"
                                      Margin="0,3,0,0"
                                      Header="More"
                                      Expanded="OnNowMoreChanged"
                                      Collapsed="OnNowMoreChanged">
                                <StackPanel Margin="0,7,0,0">
                                    <TextBlock x:Name="ReadinessText"
                                               Style="{StaticResource BG3Caption}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="MuteButton"
                                                Margin="0,0,4,4"
                                                Style="{StaticResource BG3ActionButton}"
                                                AutomationProperties.Name="Mute warnings for current checkpoint"
                                                Click="OnMuteClick"
                                                Content="Mute warnings" />
                                        <Button x:Name="ClearTargetButton"
                                                Margin="0,0,4,4"
                                                Style="{StaticResource BG3ActionButton}"
                                                AutomationProperties.Name="Clear current equipment target"
                                                Click="OnClearTargetClick"
                                                Content="Clear gear target"
                                                Visibility="Collapsed" />
                                        <Button x:Name="PinFightButton"
                                                Margin="0,0,4,4"
                                                Style="{StaticResource BG3ActionButton}"
                                                AutomationProperties.Name="Pin current fight"
                                                Click="OnPinFightClick"
                                                Content="Pin fight" />
                                        <Button Margin="0,0,4,4"
                                                Style="{StaticResource BG3ActionButton}"
                                                AutomationProperties.Name="Snooze warnings for ten minutes"
                                                Click="OnSnoozeClick"
                                                Content="Snooze 10 min" />
                                        <Button Margin="0,0,4,4"
                                                Style="{StaticResource BG3ActionButton}"
                                                AutomationProperties.Name="Follow recommended route"
                                                Click="OnFollowRouteClick"
                                                Content="Follow recommendation" />
                                        <Button Margin="0,0,4,4"
                                                Style="{StaticResource BG3ActionButton}"
                                                AutomationProperties.Name="Revisit current activity"
                                                Click="OnRevisitCurrentClick"
                                                Content="Revisit" />
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#668C5224" />
                        <Grid Grid.Row="1"
                              Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource BG3SuccessActionButton}"
                                    AutomationProperties.Name="Mark current activity complete"
                                    Click="OnCompleteCurrentClick"
                                    Content="✓  Done" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource BG3ActionButton}"
                                    AutomationProperties.Name="Skip current activity"
                                    Click="OnSkipCurrentClick"
                                    Content="▹  Skip" />
                        </Grid>
                    </Grid>
                </Grid>
</UserControl>
