<UserControl x:Class="BG3HonorAssistant.App.Screens.Act.ActView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core"
        Background="Transparent">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,7,0,8">
                        <Border Padding="8"
                                Background="{StaticResource BG3InsetBrush}"
                                BorderBrush="#858C5224"
                                BorderThickness="0.7"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource BG3Overline}"
                                               Text="ACT LEDGER" />
                                    <TextBlock x:Name="ActLedgerStatusText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource BG3Overline}"
                                               Text="ACTIVE RUN" />
                                </Grid>
                                <UniformGrid Margin="0,6,0,0"
                                             HorizontalAlignment="Left"
                                             Columns="3">
                                    <Button x:Name="Act1LedgerButton"
                                            Width="54"
                                            Padding="7,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnActLedgerClick"
                                            Content="Act 1"
                                            Tag="1" />
                                    <Button x:Name="Act2LedgerButton"
                                            Width="54"
                                            Margin="-1,0,0,0"
                                            Padding="7,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnActLedgerClick"
                                            Content="Act 2"
                                            Tag="2" />
                                    <Button x:Name="Act3LedgerButton"
                                            Width="54"
                                            Margin="-1,0,0,0"
                                            Padding="7,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnActLedgerClick"
                                            Content="Act 3"
                                            Tag="3" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,8,0,0"
                                Padding="9"
                                Background="{StaticResource BG3InsetBrush}"
                                BorderBrush="#858C5224"
                                BorderThickness="0.7"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="ActNumberText"
                                               Style="{StaticResource BG3Overline}"
                                               Text="ACT 1" />
                                    <TextBlock x:Name="ActEquipmentCountText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource BG3Caption}"
                                               FontWeight="Bold"
                                               Text="65 equipment rows" />
                                </Grid>
                                <TextBlock x:Name="ActTitleText"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource BG3PageTitle}"
                                           Text="Wilderness, Underdark &amp; Mountain Pass" />
                                <StackPanel Margin="0,5,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock x:Name="ActRouteStatusIcon"
                                               Margin="0,0,4,0"
                                               Foreground="{StaticResource BG3MutedParchmentBrush}"
                                               Text="●" />
                                    <TextBlock x:Name="ActAvailabilityText"
                                               Style="{StaticResource BG3Caption}"
                                               Text="Route available" />
                                    <TextBlock Margin="9,0,4,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{StaticResource BG3BronzeBrightBrush}"
                                               Text="&#xE707;" />
                                    <TextBlock x:Name="ActMapNameText"
                                               Style="{StaticResource BG3Caption}"
                                               Foreground="{StaticResource BG3BronzeBrightBrush}"
                                               Text="Wilderness" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,8,0,0"
                                Padding="9"
                                Background="{StaticResource BG3InsetBrush}"
                                BorderBrush="#858C5224"
                                BorderThickness="0.7"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource BG3Overline}"
                                               Text="EQUIPMENT REVIEW" />
                                    <TextBlock x:Name="ActReviewCountText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource BG3Caption}"
                                               FontWeight="Bold"
                                               Text="0/0" />
                                </Grid>
                                <TextBlock x:Name="ActReviewHelpText"
                                           Margin="0,5,0,4"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ActEmptyReviewText"
                                           Margin="0,7,0,7"
                                           Style="{StaticResource BG3Caption}"
                                           Text="Assign reviewed builds on Party to create an equipment checklist."
                                           TextWrapping="Wrap" />
                                <ItemsControl x:Name="ActPendingGearList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="27"
                                                        Height="27"
                                                        BorderBrush="{StaticResource BG3GoldBrush}"
                                                        BorderThickness="0.8"
                                                        CornerRadius="5">
                                                    <Image Source="{Binding Gear, Converter={StaticResource ItemIconConverter}}"
                                                           Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="0,0,5,0">
                                                    <TextBlock Style="{StaticResource BG3Caption}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource BG3SuccessBrush}"
                                                               Text="{Binding Gear.Item}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource BG3Caption}"
                                                               FontSize="9"
                                                               Text="{Binding Detail}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Width="24"
                                                        Height="24"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        Foreground="{StaticResource BG3SuccessBrush}"
                                                        Visibility="{Binding ActionVisibility}"
                                                        Click="OnActGearObtainedClick"
                                                        Content="✓"
                                                        ToolTip="Mark obtained" />
                                                <Button Grid.Column="3"
                                                        Width="24"
                                                        Height="24"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        Foreground="{StaticResource BG3DangerBrush}"
                                                        Visibility="{Binding ActionVisibility}"
                                                        Click="OnActGearMissedClick"
                                                        Content="✕"
                                                        ToolTip="Mark missed" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander x:Name="ActReviewedExpander"
                                          Margin="0,6,0,0"
                                          Foreground="{StaticResource BG3SuccessBrush}"
                                          Header="●  Reviewed (0)">
                                    <ItemsControl x:Name="ActReviewedGearList"
                                                  Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="27"
                                                            Height="27"
                                                            BorderBrush="{StaticResource BG3GoldBrush}"
                                                            BorderThickness="0.8"
                                                            CornerRadius="5">
                                                        <Image Source="{Binding Gear, Converter={StaticResource ItemIconConverter}}"
                                                               Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="0,0,5,0">
                                                        <TextBlock Style="{StaticResource BG3Caption}"
                                                                   FontWeight="Bold"
                                                                   Text="{Binding Gear.Item}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource BG3Caption}"
                                                                   FontSize="9"
                                                                   Text="{Binding Detail}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            Foreground="{StaticResource BG3SuccessBrush}"
                                                            Visibility="{Binding ActionVisibility}"
                                                            Click="OnActGearObtainedClick"
                                                            Content="✓"
                                                            ToolTip="Revise as obtained" />
                                                    <Button Grid.Column="3"
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            Foreground="{StaticResource BG3DangerBrush}"
                                                            Visibility="{Binding ActionVisibility}"
                                                            Click="OnActGearMissedClick"
                                                            Content="✕"
                                                            ToolTip="Revise as missed" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ActConsequencesPanel"
                                Margin="0,8,0,0"
                                Padding="9"
                                Background="{StaticResource BG3InsetBrush}"
                                BorderBrush="{StaticResource BG3WarningBrush}"
                                BorderThickness="0.7"
                                CornerRadius="8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ActConsequencesTitleText"
                                           Style="{StaticResource BG3Overline}"
                                           Foreground="{StaticResource BG3WarningBrush}"
                                           Text="UNRESOLVED CONSEQUENCES · 0" />
                                <ItemsControl x:Name="ActConsequencesList"
                                              Margin="0,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2,0,0"
                                                       Style="{StaticResource BG3Caption}"
                                                       Foreground="{StaticResource BG3WarningBrush}"
                                                       Text="{Binding StringFormat=▲  {0}}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox x:Name="ActAcceptConsequencesCheckBox"
                                          Margin="0,7,0,0"
                                          Click="OnActAcceptanceChanged"
                                          Content="I accept these unresolved Act 1 consequences" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ActBrowsingPanel"
                                Margin="0,8,0,0"
                                Padding="9"
                                Background="{StaticResource BG3InsetBrush}"
                                BorderBrush="#858C5224"
                                BorderThickness="0.7"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="ActBrowsingTitleText"
                                           Style="{StaticResource BG3RowTitle}"
                                           Foreground="{StaticResource BG3GoldBrush}"
                                           Text="◉  Previewing Act 2" />
                                <TextBlock x:Name="ActBrowsingBodyText"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                                <Button x:Name="ReturnActiveActButton"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource BG3ActionButton}"
                                        Click="OnReturnActiveActClick"
                                        Content="Return to active Act 1" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ActTransitionPanel"
                                Margin="0,8,0,0"
                                Padding="9"
                                Background="{StaticResource BG3InsetBrush}"
                                BorderBrush="#858C5224"
                                BorderThickness="0.7"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="ActGateText"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                                <Button x:Name="AdvanceActButton"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource BG3ProminentActionButton}"
                                        Click="OnAdvanceActClick"
                                        Content="Advance to Act 2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
