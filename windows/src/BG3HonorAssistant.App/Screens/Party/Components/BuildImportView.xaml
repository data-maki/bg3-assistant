<UserControl x:Class="BG3HonorAssistant.App.Screens.Party.Components.BuildImportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core">
<Border x:Name="PartyBuildImportPopover"
                                Panel.ZIndex="10"
                                Margin="4,0,4,74"
                                Padding="12"
                                VerticalAlignment="Bottom"
                                Background="#FA0E0C09"
                                BorderBrush="#668C5224"
                                BorderThickness="0.7"
                                CornerRadius="12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource BG3MutedParchmentBrush}"
                                            Click="OnClosePartyBuildImportClick"
                                            Content="×" />
                                    <TextBlock Style="{StaticResource BG3Overline}"
                                               Text="IMPORT REUSABLE BUILD" />
                                </DockPanel>
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           Text="Paste one public build guide. After review, it will be assigned to this character and remain available to everyone."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           Foreground="{StaticResource BG3GoldBrush}"
                                           Text="☁  Importing with OpenRouter" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PartyBuildImportUrlTextBox"
                                             AutomationProperties.Name="Public build URL" />
                                    <Button x:Name="PartyImportBuildButton"
                                            Grid.Column="2"
                                            Style="{StaticResource BG3ProminentActionButton}"
                                            Click="OnPartyImportBuildClick"
                                            Content="⇩  Import" />
                                </Grid>
                                <TextBlock x:Name="PartyBuildImportStatusText"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
</UserControl>
