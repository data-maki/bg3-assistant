<UserControl x:Class="BG3HonorAssistant.App.Screens.Party.Components.PartyLandingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core">
<Grid x:Name="PartyGuidancePage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock x:Name="PartyActiveCountText"
                                       DockPanel.Dock="Right"
                                       Style="{StaticResource BG3Caption}"
                                       FontWeight="Bold"
                                       Text="0/4 active" />
                            <TextBlock Style="{StaticResource BG3Overline}"
                                       Text="ACTIVE PARTY" />
                            <TextBlock Margin="7,0,0,0"
                                       Style="{StaticResource BG3Caption}"
                                       Text="Level guidance" />
                        </DockPanel>
                        <ListBox x:Name="PartyGrid"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnPartyMemberSelectionChanged"
                                 AutomationProperties.Name="Active party guidance">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="9"
                                            Background="{StaticResource BG3InsetBrush}"
                                            BorderBrush="#4D8C5224"
                                            BorderThickness="0.7"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30"
                                                        Height="30"
                                                        BorderBrush="#8C8C5224"
                                                        BorderThickness="0.7"
                                                        CornerRadius="7">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource BG3SerifFont}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Text="{Binding Name[0]}" />
                                                        <Image Stretch="UniformToFill"
                                                               Source="{Binding Name, Converter={StaticResource CompanionPortraitConverter}}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource BG3RowTitle}"
                                                               Text="{Binding Name}" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource BG3Caption}"
                                                                   Text="{Binding Level, StringFormat=L{0} · }" />
                                                        <TextBlock x:Name="BuildText"
                                                                   Style="{StaticResource BG3Caption}"
                                                                   Text="{Binding BuildId}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource BG3MutedParchmentBrush}"
                                                           Text="›" />
                                            </Grid>
                                            <DockPanel x:Name="MissingBuildRow"
                                                       Margin="0,6,0,0"
                                                       Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Style="{StaticResource BG3Caption}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BG3GoldBrush}"
                                                           Text="Choose ›" />
                                                <TextBlock Style="{StaticResource BG3Caption}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BG3WarningBrush}"
                                                           Text="⚠  Choose a reviewed build" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding BuildId}" Value="{x:Null}">
                                            <Setter TargetName="BuildText" Property="Text" Value="No build" />
                                            <Setter TargetName="MissingBuildRow" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2"
                                Margin="0,7,0,0"
                                Style="{StaticResource BG3ProminentActionButton}"
                                Click="OnManagePartyClick"
                                Content="♙  Manage party members                                      ›" />
                    </Grid>
</UserControl>
