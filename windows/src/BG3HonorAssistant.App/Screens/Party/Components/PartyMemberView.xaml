<UserControl x:Class="BG3HonorAssistant.App.Screens.Party.Components.PartyMemberView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core">
<Grid x:Name="PartyMemberDetailPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,7">
                                <Button DockPanel.Dock="Left"
                                        Style="{StaticResource BG3ActionButton}"
                                        Click="OnPartyBackClick"
                                        Content="‹  Party" />
                                <Border DockPanel.Dock="Right"
                                        Padding="7,2"
                                        Background="#217D9194"
                                        BorderBrush="#7A7D9194"
                                        BorderThickness="0.7"
                                        CornerRadius="8">
                                    <TextBlock x:Name="PartyDetailStatusText"
                                               Style="{StaticResource BG3Caption}"
                                               FontWeight="Bold" />
                                </Border>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Padding="10"
                                            Background="{StaticResource BG3InsetBrush}"
                                            BorderBrush="#4D8C5224"
                                            BorderThickness="0.7"
                                            CornerRadius="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="PartyDetailNameText"
                                                           Style="{StaticResource BG3PageTitle}" />
                                                <TextBlock x:Name="PartyDetailIdentityText"
                                                           Margin="0,3,0,0"
                                                           Style="{StaticResource BG3Caption}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock HorizontalAlignment="Right"
                                                           Style="{StaticResource BG3Overline}"
                                                           Foreground="{StaticResource BG3MutedParchmentBrush}"
                                                           Text="LEVEL" />
                                                <ComboBox x:Name="PartyLevelPicker"
                                                          SelectionChanged="OnPartyLevelChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Margin="0,8,0,0"
                                            Padding="10"
                                            Background="{StaticResource BG3InsetBrush}"
                                            BorderBrush="#4D8C5224"
                                            BorderThickness="0.7"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource BG3GoldBrush}"
                                                        Click="OnPartyAbilitiesClick"
                                                        Content="Boosts &amp; progression ›" />
                                                <TextBlock Style="{StaticResource BG3Overline}"
                                                           Text="ABILITY SCORES" />
                                            </DockPanel>
                                            <TextBlock x:Name="PartyAbilitySummaryText"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource BG3Body}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,8,0,0"
                                            Padding="10"
                                            Background="{StaticResource BG3InsetBrush}"
                                            BorderBrush="#4D8C5224"
                                            BorderThickness="0.7"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <TextBlock x:Name="PartyGuidanceStatusText"
                                                       Style="{StaticResource BG3Overline}" />
                                            <TextBlock x:Name="PartyGuidanceTakeText"
                                                       Margin="0,6,0,0"
                                                       Style="{StaticResource BG3RowTitle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="PartyGuidanceChoicesText"
                                                       Margin="0,5,0,0"
                                                       Style="{StaticResource BG3Caption}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="PartyGuidanceTacticsText"
                                                       Margin="0,5,0,0"
                                                       Style="{StaticResource BG3Caption}"
                                                       Foreground="{StaticResource BG3SuccessBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,8,0,0"
                                            Padding="10"
                                            Background="{StaticResource BG3InsetBrush}"
                                            BorderBrush="#4D8C5224"
                                            BorderThickness="0.7"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BG3Overline}"
                                                       Text="BUILD IT YOURSELF" />
                                            <TextBlock Margin="0,5,0,7"
                                                       Style="{StaticResource BG3Caption}"
                                                       Text="Set point buy and plan class, feat, spell, and subclass choices through Level 12."
                                                       TextWrapping="Wrap" />
                                            <Button Style="{StaticResource BG3ProminentActionButton}"
                                                    Click="OnManualBuildClick"
                                                    Content="Create or edit manual build" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,8,0,0"
                                            Padding="10"
                                            Background="{StaticResource BG3InsetBrush}"
                                            BorderBrush="#4D8C5224"
                                            BorderThickness="0.7"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button x:Name="CompareBuildsButton"
                                                        DockPanel.Dock="Right"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource BG3GoldBrush}"
                                                        Click="OnCompareBuildsClick"
                                                        Content="Compare builds" />
                                                <TextBlock Style="{StaticResource BG3Overline}"
                                                           Text="BUILD" />
                                            </DockPanel>
                                            <ComboBox x:Name="PartyBuildPicker"
                                                      Margin="0,7,0,0"
                                                      DisplayMemberPath="Label"
                                                      SelectionChanged="OnPartyBuildChanged" />
                                            <Button Margin="0,7,0,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource BG3ActionButton}"
                                                    Click="OnOpenBuildImportClick"
                                                    Content="Import build from URL…" />
                                            <ListBox x:Name="PartyBuildComparisonList"
                                                     Margin="0,7,0,0"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Visibility="Collapsed"
                                                     SelectionChanged="OnPartyBuildComparisonChanged">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,0,0,6" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="8"
                                                                Background="#660E0C09"
                                                                BorderBrush="#4D8C5224"
                                                                BorderThickness="0.7"
                                                                CornerRadius="8">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right"
                                                                               Style="{StaticResource BG3Caption}"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource BG3SuccessBrush}"
                                                                               Text="{Binding HonorStatus}" />
                                                                    <TextBlock Style="{StaticResource BG3Caption}"
                                                                               FontWeight="Bold"
                                                                               Text="{Binding Name}" />
                                                                </DockPanel>
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Style="{StaticResource BG3Caption}"
                                                                           Text="{Binding Role}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           Style="{StaticResource BG3Caption}"
                                                                           Foreground="{StaticResource BG3GoldBrush}"
                                                                           Text="{Binding FinalSplit}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,8,0,0"
                                            Padding="10"
                                            Background="{StaticResource BG3InsetBrush}"
                                            BorderBrush="#66C75247"
                                            BorderThickness="0.7"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BG3Overline}"
                                                       Foreground="{StaticResource BG3DangerBrush}"
                                                       Text="DANGEROUS ACTIONS" />
                                            <Button Margin="0,7,0,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource BG3ActionButton}"
                                                    BorderBrush="{StaticResource BG3DangerBrush}"
                                                    Click="OnResetCharacterClick"
                                                    Content="Reset character plan…" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
</UserControl>
