<UserControl x:Class="BG3HonorAssistant.App.Screens.Party.PartyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core"
        xmlns:components="clr-namespace:BG3HonorAssistant.App.Screens.Party.Components"
        Background="Transparent">

                <Grid Margin="0,7,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="PartyUndoBanner"
                            Margin="0,0,0,7"
                            Padding="7"
                            Background="{StaticResource BG3InsetBrush}"
                            BorderBrush="{StaticResource BG3ControlBrush}"
                            BorderThickness="0.7"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Margin="6,0,0,0"
                                    Padding="3,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnDismissPartyUndoClick"
                                    Content="×"
                                    AutomationProperties.Name="Dismiss undo" />
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource BG3ActionButton}"
                                    Click="OnUndoPartyChangeClick"
                                    Content="Undo" />
                            <TextBlock x:Name="PartyUndoText"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BG3Caption}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PartyGuidanceColumn" Width="*" />
                            <ColumnDefinition x:Name="PartyDetailColumn" Width="0" />
                        </Grid.ColumnDefinitions>

                        <components:PartyLandingView x:Name="Landing" />

                        <Grid x:Name="PartyNestedPage"
                              Grid.Column="1">
                            <components:PartyMemberView x:Name="Member" />

                            <components:PartyRosterView x:Name="Roster" />

                            <components:PartyAbilitiesView x:Name="Abilities" />

                            <components:ManualBuildView x:Name="ManualBuild" />

                            <components:BuildImportView x:Name="BuildImport" />
                        </Grid>
                    </Grid>
                </Grid>
</UserControl>
