<UserControl x:Class="BG3HonorAssistant.App.Screens.Route.RouteView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BG3HonorAssistant.App.UI"
        xmlns:models="clr-namespace:BG3HonorAssistant.Core.Models;assembly=BG3HonorAssistant.Core"
        Background="Transparent">

                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="RouteListColumn" Width="*" />
                        <ColumnDefinition x:Name="RouteDetailColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="RouteListPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="8"
                                Margin="0,0,0,5"
                                Background="{StaticResource BG3InsetBrush}"
                                BorderBrush="#4D8C5224"
                                BorderThickness="0.7"
                                CornerRadius="9">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="RouteOverlineText"
                                               Style="{StaticResource BG3Overline}"
                                               Text="ROUTE · ACT 1" />
                                    <TextBlock Margin="0,0,7,0"
                                               DockPanel.Dock="Right"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource BG3Caption}"
                                               FontWeight="Bold"
                                               Text="Party" />
                                    <TextBlock x:Name="RouteProgressText"
                                               DockPanel.Dock="Right"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource BG3Caption}"
                                               FontWeight="Bold" />
                                </DockPanel>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="RouteProgressBar"
                                                 Height="6"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Minimum="0"
                                                 Maximum="1"
                                                 AutomationProperties.Name="Route progress" />
                                    <TextBlock x:Name="RouteDoneText"
                                               Grid.Column="1"
                                               Style="{StaticResource BG3Caption}"
                                               FontWeight="Bold" />
                                </Grid>
                                <TextBlock x:Name="RouteGateText"
                                           Style="{StaticResource BG3Caption}"
                                           Foreground="{StaticResource BG3WarningBrush}"
                                           TextWrapping="Wrap" />
                                <Expander x:Name="RouteDeadlinesExpander"
                                          Margin="0,4,0,0"
                                          Header="Deadlines and lockouts">
                                    <ListBox x:Name="RouteDeadlineList"
                                             Margin="0,5,0,0"
                                             AutomationProperties.Name="Route deadlines">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Foreground="{StaticResource BG3MutedParchmentBrush}"
                                                               Text="{Binding Deadline}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{StaticResource BG3DangerBrush}"
                                                               Text="{Binding Consequence}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                                <Border Margin="0,5,0,0"
                                        Padding="2"
                                        Background="#A30E0C09"
                                        CornerRadius="6">
                                    <UniformGrid Columns="3">
                                        <Button x:Name="RouteAllButton"
                                                Style="{StaticResource BG3PlannerTabButton}"
                                                Click="OnRouteFilterButtonClick"
                                                Content="All"
                                                Tag="All" />
                                        <Button x:Name="RouteCoreButton"
                                                Style="{StaticResource BG3PlannerTabButton}"
                                                Click="OnRouteFilterButtonClick"
                                                Content="Core"
                                                Tag="Core" />
                                        <Button x:Name="RouteEquipmentButton"
                                                Style="{StaticResource BG3PlannerTabButton}"
                                                Click="OnRouteFilterButtonClick"
                                                Content="Equipment"
                                                Tag="Equipment" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock x:Name="RouteSpoilerText"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           Foreground="{StaticResource BG3SuccessBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="RouteList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Route and equipment steps"
                                 SelectionChanged="OnRouteSelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,5" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border x:Name="PhaseRow"
                                                Padding="6,4"
                                                Background="#F00E0C09"
                                                Visibility="Collapsed">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Style="{StaticResource BG3Overline}"
                                                           Text="{Binding Meta}" />
                                                <TextBlock Style="{StaticResource BG3Overline}"
                                                           Text="{Binding Label}" />
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="RouteCard"
                                                Padding="8,6"
                                                Background="#3D0E0C09"
                                                BorderBrush="#4D8C5224"
                                                BorderThickness="0.7"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{StaticResource BG3WarningBrush}"
                                                           Text="◆" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource BG3RowTitle}"
                                                               Text="{Binding Label}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource BG3Caption}"
                                                               Text="{Binding Meta}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Padding="6,2"
                                                        Margin="4,0"
                                                        VerticalAlignment="Center"
                                                        Background="#338C5224"
                                                        BorderBrush="#808C5224"
                                                        BorderThickness="0.7"
                                                        CornerRadius="8">
                                                    <TextBlock Style="{StaticResource BG3Caption}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource BG3GoldBrush}"
                                                               Text="{Binding Status}" />
                                                </Border>
                                                <TextBlock Grid.Column="3"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource BG3MutedParchmentBrush}"
                                                           Text="›" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Phase">
                                            <Setter TargetName="PhaseRow" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="RouteCard" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <ScrollViewer x:Name="RouteDetailScroll"
                                  Grid.Column="1"
                                  Margin="0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <Button DockPanel.Dock="Left"
                                        Style="{StaticResource BG3ActionButton}"
                                        Click="OnRouteBackClick"
                                        Content="‹  Route" />
                                <Button DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource BG3ActionButton}"
                                        Click="OnFocusSelectedStepClick"
                                        Content="Set focus" />
                            </DockPanel>
                            <StackPanel x:Name="RouteStepPanel">
                                <TextBlock x:Name="RouteStepTitleText"
                                           Style="{StaticResource BG3PageTitle}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepMetaText"
                                           Margin="0,4,0,7"
                                           Style="{StaticResource BG3Caption}" />
                                <Border Height="1"
                                        Margin="0,0,0,7"
                                        Background="#668C5224" />
                                <TextBlock x:Name="RouteStepSummaryText"
                                           Style="{StaticResource BG3Body}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepAvoidText"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource BG3Body}"
                                           Foreground="{StaticResource BG3DangerBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepWhyText"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepRewardsText"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource BG3Body}"
                                           Foreground="{StaticResource BG3GoldBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepPrerequisitesText"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepCompletionText"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteStepOutcomeText"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource BG3Body}"
                                           Foreground="{StaticResource BG3SuccessBrush}"
                                           TextWrapping="Wrap" />
                                <Border x:Name="RouteDecisionGroup"
                                        Margin="0,9,0,0"
                                        Padding="8"
                                        Background="{StaticResource BG3InsetBrush}"
                                        BorderBrush="#4D8C5224"
                                        BorderThickness="0.7"
                                        CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BG3Overline}"
                                                   Text="REVIEWED CHOICE" />
                                        <TextBlock x:Name="RouteDecisionText"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource BG3Caption}"
                                                   TextWrapping="Wrap" />
                                        <ComboBox x:Name="RouteOutcomePicker"
                                                  Margin="0,8,0,0"
                                                  DisplayMemberPath="Label"
                                                  AutomationProperties.Name="Route outcome" />
                                        <Button Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource BG3ActionButton}"
                                                Click="OnRecordOutcomeClick"
                                                Content="Record selected outcome" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="RouteIncidentGroup"
                                        Margin="0,9,0,0"
                                        Padding="8"
                                        Background="{StaticResource BG3InsetBrush}"
                                        BorderBrush="#4D8C5224"
                                        BorderThickness="0.7"
                                        CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BG3Overline}"
                                                   Text="IF THE PLAN BREAKS" />
                                        <TextBlock x:Name="RouteIncidentText"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource BG3Caption}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="RouteRiskGroup"
                                        Margin="0,9,0,0"
                                        Padding="8"
                                        Background="{StaticResource BG3InsetBrush}"
                                        BorderBrush="#4D8C5224"
                                        BorderThickness="0.7"
                                        CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BG3Overline}"
                                                   Text="RISK AND REWARD" />
                                        <TextBlock x:Name="RouteRiskText"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource BG3Caption}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="RouteDoneButton"
                                            Margin="0,0,4,4"
                                            Style="{StaticResource BG3SuccessActionButton}"
                                            Click="OnCompleteSelectedStepClick"
                                            Content="✓  Done" />
                                    <Button x:Name="RouteSkipButton"
                                            Margin="0,0,4,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnSkipSelectedStepClick"
                                            Content="Skip" />
                                    <Button x:Name="RouteRevisitButton"
                                            Margin="0,0,4,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnRevisitSelectedStepClick"
                                            Content="Revisit" />
                                    <Button x:Name="RouteSourceButton"
                                            Margin="0,0,4,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnOpenRouteSourceClick"
                                            Content="Open reviewed source" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel x:Name="RouteGearPanel"
                                        Visibility="Collapsed">
                                <TextBlock Style="{StaticResource BG3Overline}"
                                           Text="ROUTE PICKUP" />
                                <TextBlock x:Name="RouteGearTitleText"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource BG3PageTitle}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteGearMetaText"
                                           Margin="0,4,0,8"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteGearEffectText"
                                           Style="{StaticResource BG3Body}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteGearAcquisitionText"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource BG3Body}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteGearWhyText"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RouteGearRequirementText"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource BG3Caption}"
                                           Foreground="{StaticResource BG3DangerBrush}"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Margin="0,0,4,4"
                                            Style="{StaticResource BG3SuccessActionButton}"
                                            Click="OnTrackRouteGearClick"
                                            Content="Track this item now" />
                                    <Button Margin="0,0,4,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnMarkRouteGearObtainedClick"
                                            Content="Mark obtained" />
                                    <Button Margin="0,0,4,4"
                                            Style="{StaticResource BG3ActionButton}"
                                            Click="OnOpenRouteGearLinkClick"
                                            Content="Open item source" />
                                </WrapPanel>
                            </StackPanel>
                            <Expander Margin="0,20,0,0"
                                      Header="Done, skipped, and caught-up steps">
                                <ListBox x:Name="ArchivedRouteList"
                                         Margin="0,8,0,0"
                                         AutomationProperties.Name="Archived route steps"
                                         SelectionChanged="OnArchivedRouteSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Label}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{StaticResource BG3MutedParchmentBrush}"
                                                           Text="{Binding Meta}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
</UserControl>
