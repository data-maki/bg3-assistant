<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Exact RGB values from mac/BG3Assistant/AssistantGlassStyle.swift. -->
    <Color x:Key="BG3InkColor">#0E0C09</Color>
    <Color x:Key="BG3UmberColor">#2E2116</Color>
    <Color x:Key="BG3BronzeColor">#8C5224</Color>
    <Color x:Key="BG3BronzeBrightColor">#9C683B</Color>
    <Color x:Key="BG3GoldColor">#C7A15E</Color>
    <Color x:Key="BG3ParchmentColor">#F0E3C2</Color>
    <Color x:Key="BG3MutedParchmentColor">#B8AB8F</Color>
    <Color x:Key="BG3ControlColor">#7D9194</Color>
    <Color x:Key="BG3SuccessColor">#619E7A</Color>
    <Color x:Key="BG3WarningColor">#C77840</Color>
    <Color x:Key="BG3CautionColor">#B8964D</Color>
    <Color x:Key="BG3DangerColor">#C75247</Color>
    <Color x:Key="BG3FightColor">#EB6B57</Color>
    <Color x:Key="BG3TalkColor">#8CC7F2</Color>

    <SolidColorBrush x:Key="BG3InkBrush" Color="{StaticResource BG3InkColor}" />
    <SolidColorBrush x:Key="BG3UmberBrush" Color="{StaticResource BG3UmberColor}" />
    <SolidColorBrush x:Key="BG3BronzeBrush" Color="{StaticResource BG3BronzeColor}" />
    <SolidColorBrush x:Key="BG3BronzeBrightBrush" Color="{StaticResource BG3BronzeBrightColor}" />
    <SolidColorBrush x:Key="BG3GoldBrush" Color="{StaticResource BG3GoldColor}" />
    <SolidColorBrush x:Key="BG3ParchmentBrush" Color="{StaticResource BG3ParchmentColor}" />
    <SolidColorBrush x:Key="BG3MutedParchmentBrush" Color="{StaticResource BG3MutedParchmentColor}" />
    <SolidColorBrush x:Key="BG3ControlBrush" Color="{StaticResource BG3ControlColor}" />
    <SolidColorBrush x:Key="BG3SuccessBrush" Color="{StaticResource BG3SuccessColor}" />
    <SolidColorBrush x:Key="BG3WarningBrush" Color="{StaticResource BG3WarningColor}" />
    <SolidColorBrush x:Key="BG3CautionBrush" Color="{StaticResource BG3CautionColor}" />
    <SolidColorBrush x:Key="BG3DangerBrush" Color="{StaticResource BG3DangerColor}" />

    <LinearGradientBrush x:Key="BG3PanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F02E2116" />
        <GradientStop Offset="1" Color="#F50E0C09" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BG3InsetBrush" Color="#A30E0C09" />
    <SolidColorBrush x:Key="BG3ActionBrush" Color="#1A7D9194" />
    <SolidColorBrush x:Key="BG3ActionBorderBrush" Color="#7A7D9194" />
    <SolidColorBrush x:Key="BG3ProminentActionBrush" Color="#479C683B" />
    <SolidColorBrush x:Key="BG3ProminentActionBorderBrush" Color="#C79C683B" />
    <SolidColorBrush x:Key="BG3SuccessActionBrush" Color="#47619E7A" />
    <SolidColorBrush x:Key="BG3SuccessActionBorderBrush" Color="#C7619E7A" />

    <FontFamily x:Key="BG3BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="BG3SerifFont">Georgia</FontFamily>

    <Style x:Key="BG3ActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BG3ActionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BG3ActionBorderBrush}" />
        <Setter Property="BorderThickness" Value="0.8" />
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BG3ProminentActionButton"
           TargetType="Button"
           BasedOn="{StaticResource BG3ActionButton}">
        <Setter Property="Background" Value="{StaticResource BG3ProminentActionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BG3ProminentActionBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.1" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="BG3SuccessActionButton"
           TargetType="Button"
           BasedOn="{StaticResource BG3ActionButton}">
        <Setter Property="Background" Value="{StaticResource BG3SuccessActionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BG3SuccessActionBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.1" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="BG3IconButton"
           TargetType="Button"
           BasedOn="{StaticResource BG3ActionButton}">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="BG3PlannerTabButton"
           TargetType="Button"
           BasedOn="{StaticResource BG3ActionButton}">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0.7" />
        <Setter Property="FontFamily" Value="{StaticResource BG3SerifFont}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#C6B8AB8F" />
    </Style>

    <Style x:Key="BG3Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BG3SerifFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BG3GoldBrush}" />
    </Style>

    <Style x:Key="BG3Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource BG3MutedParchmentBrush}" />
    </Style>

    <Style x:Key="BG3Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
    </Style>

    <Style x:Key="BG3RowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
    </Style>

    <Style x:Key="BG3PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BG3SerifFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BG3InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BG3ActionBorderBrush}" />
        <Setter Property="BorderThickness" Value="0.8" />
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource BG3ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource BG3InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BG3ActionBorderBrush}" />
        <Setter Property="BorderThickness" Value="0.8" />
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource BG3ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BG3InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BG3ActionBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="5,3" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource BG3ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BG3BodyFont}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
</ResourceDictionary>
