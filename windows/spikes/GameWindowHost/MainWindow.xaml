<Window x:Class="GameWindowHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="Manual"
        Background="#FF10131A"
        Foreground="#FFF4E8C1"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True">
    <Grid>
        <Border Margin="24"
                Padding="28"
                BorderBrush="#FFB99A4C"
                BorderThickness="2">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="30"
                           FontWeight="SemiBold"
                           Text="Controlled BG3 window" />
                <TextBlock x:Name="ModeText"
                           Margin="0,12,0,0"
                           FontSize="16" />
                <TextBlock Margin="0,8,0,0"
                           Text="This is test infrastructure. It is not Baldur's Gate 3."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
