<Window x:Class="OverlayHarness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BG3 Overlay Harness"
        Width="380"
        Height="250"
        MinWidth="320"
        MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        SourceInitialized="OnSourceInitialized"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
    <Border Margin="8"
            Padding="18"
            Background="#E8161422"
            BorderBrush="#806C63FF"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FFF3F0FF"
                           Text="BG3 overlay platform proof" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FFB9B2D2"
                           Text="Passive HWND · topmost · BG3-relative · 2s recovery poll" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,12">
                <TextBlock x:Name="StatusText"
                           Foreground="#FFE9E5F3"
                           TextWrapping="Wrap"
                           Text="Waiting for source initialization…" />
                <TextBox x:Name="ActivationProbe"
                         Margin="0,14,0,0"
                         Padding="9,6"
                         PreviewMouseDown="OnProbePreviewMouseDown"
                         GotKeyboardFocus="OnProbeGotKeyboardFocus"
                         LostKeyboardFocus="OnProbeLostKeyboardFocus"
                         Text="Click here to prove deliberate activation" />
            </StackPanel>

            <DockPanel Grid.Row="2">
                <Button Padding="10,5"
                        Click="OnLocateClick"
                        Content="Locate BG3 now" />
                <TextBlock x:Name="DpiText"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#FFA9A0C5"
                           Text="DPI: pending" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
