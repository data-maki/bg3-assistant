<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BG3Architecture Condition="'$(BG3Architecture)' == '' and ('$(Platform)' == 'x64' or '$(Platform)' == 'arm64')">$(Platform)</BG3Architecture>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(BG3Architecture)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(BG3Architecture)' == 'arm64'">win-arm64</RuntimeIdentifier>
    <Platform Condition="'$(Platform)' == '' and '$(BG3Architecture)' != ''">$(BG3Architecture)</Platform>
    <PlatformTarget Condition="'$(PlatformTarget)' == '' and '$(BG3Architecture)' != ''">$(BG3Architecture)</PlatformTarget>
    <Platforms>x64;arm64</Platforms>
    <DefineConstants Condition="'$(BG3Architecture)' == 'x64'">$(DefineConstants);BG3_TESTHOST_X64</DefineConstants>
    <DefineConstants Condition="'$(BG3Architecture)' == 'arm64'">$(DefineConstants);BG3_TESTHOST_ARM64</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <Target Name="ValidateBG3Architecture"
          BeforeTargets="Restore;PrepareForBuild;Publish">
    <Error Condition="'$(BG3Architecture)' == ''"
           Text="BG3Architecture is required. Pass -p:BG3Architecture=x64 or -p:BG3Architecture=arm64." />
    <Error Condition="'$(BG3Architecture)' != 'x64' and '$(BG3Architecture)' != 'arm64'"
           Text="Unsupported BG3Architecture '$(BG3Architecture)'. Supported values are x64 and arm64; 32-bit x86 is not supported." />
    <Error Condition="'$(BG3Architecture)' == 'x64' and '$(RuntimeIdentifier)' != 'win-x64'"
           Text="RuntimeIdentifier '$(RuntimeIdentifier)' conflicts with BG3Architecture 'x64'; expected 'win-x64'." />
    <Error Condition="'$(BG3Architecture)' == 'arm64' and '$(RuntimeIdentifier)' != 'win-arm64'"
           Text="RuntimeIdentifier '$(RuntimeIdentifier)' conflicts with BG3Architecture 'arm64'; expected 'win-arm64'." />
    <Error Condition="'$(BG3Architecture)' != '' and '$(Platform)' != '$(BG3Architecture)'"
           Text="Platform '$(Platform)' conflicts with BG3Architecture '$(BG3Architecture)'." />
    <Error Condition="'$(BG3Architecture)' != '' and '$(PlatformTarget)' != '$(BG3Architecture)'"
           Text="PlatformTarget '$(PlatformTarget)' conflicts with BG3Architecture '$(BG3Architecture)'." />
    <Error Condition="'$(RuntimeIdentifiers)' != 'win-x64;win-arm64'"
           Text="RuntimeIdentifiers must remain exactly 'win-x64;win-arm64'." />
  </Target>
</Project>
